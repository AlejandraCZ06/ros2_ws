<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- IMU                       -->
  <!-- ========================= -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- LIDAR 2D                  -->
  <!-- ========================= -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.125" r="0.05" h="0.06"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- CÁMARA DE PROFUNDIDAD     -->
  <!-- ========================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.10 0.03"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.10 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.035" x="0.02" y="0.10" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Frame óptico de la cámara (estándar ROS) -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.01 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
